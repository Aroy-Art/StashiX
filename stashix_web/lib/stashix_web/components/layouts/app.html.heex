<div class="flex h-screen h-dvh overflow-hidden bg-gray-950 text-gray-100">
  <%!-- Mobile backdrop --%>
  <%= if Map.get(assigns, :current_user) do %>
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 bg-black/60 z-30 hidden lg:hidden"
      onclick="closeSidebar()"
    >
    </div>

    <%!-- Sidebar --%>
    <aside
      id="sidebar"
      class="fixed inset-y-0 left-0 z-40 w-52 -translate-x-full lg:translate-x-0 lg:relative lg:z-auto flex-shrink-0 bg-gray-900 border-r border-gray-800 flex flex-col h-screen h-dvh transition-transform duration-200"
    >
      <%!-- Logo --%>
      <div class="p-4 border-b border-gray-800">
        <a href="/" class="flex items-center gap-2">
          <img src={~p"/images/logo.png"} class="w-8 h-8 object-contain" alt="Stashix" />
          <span class="text-white font-bold text-lg">Stashix</span>
        </a>
      </div>

      <%!-- Nav --%>
      <nav class="flex-1 p-2 overflow-y-auto">
        <a
          href="/"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1"
        >
          <.icon name="lucide-house" class="w-4 h-4" /> Home
        </a>

        <a
          href="/search"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1"
        >
          <.icon name="lucide-search" class="w-4 h-4" /> Search
        </a>

        <a
          href="/books"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1"
        >
          <.icon name="lucide-library-big" class="w-4 h-4" /> Books
        </a>

        <a
          href="/issues"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1"
        >
          <.icon name="lucide-layers" class="w-4 h-4" /> Issues
        </a>

        <a
          href="/series"
          class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1"
        >
          <.icon name="lucide-book-copy" class="w-4 h-4" /> Series
        </a>

        <%!-- Libraries section in sidebar --%>
        <%= if Map.get(assigns, :sidebar_libraries) do %>
          <div class="mt-4 mb-1 px-3">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Libraries</p>
          </div>
          <%= for lib <- @sidebar_libraries do %>
            <% progress = Map.get(assigns[:sidebar_scan_progress] || %{}, lib.id)

            pct =
              if progress && progress.total > 0,
                do: round(progress.scanned / progress.total * 100),
                else: nil

            scanning = not is_nil(progress) %>
            <div class="relative group/lib flex items-center mb-1">
              <a
                href={"/library/#{lib.id}"}
                class="flex-1 flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition-colors min-w-0"
              >
                <.icon
                  name={if scanning, do: "lucide-loader-circle", else: "lucide-folder"}
                  class={
                    if scanning,
                      do: "w-4 h-4 shrink-0 animate-spin text-violet-400",
                      else: "w-4 h-4 shrink-0"
                  }
                />
                <span class="truncate">{lib.name}</span>
                <%= if pct do %>
                  <span class="ml-auto text-[10px] font-mono text-violet-400 shrink-0">{pct}%</span>
                <% end %>
              </a>
              <%= if @current_user.role == :admin do %>
                <.dropdown_menu id={"lib-menu-#{lib.id}"}>
                  <.dropdown_menu_trigger class="p-1.5 rounded text-gray-500 hover:text-white hover:bg-gray-700 transition-all mr-1 shrink-0">
                    <.icon name="lucide-ellipsis-vertical" class="w-3.5 h-3.5" />
                  </.dropdown_menu_trigger>
                  <.dropdown_menu_content class="bg-gray-800 border-gray-700 text-gray-300 whitespace-nowrap">
                    <.dropdown_menu_item
                      class="hover:bg-gray-700 focus:bg-gray-700 cursor-pointer"
                      on-select={JS.push("sidebar_scan", value: %{id: lib.id})}
                    >
                      <.icon name="lucide-refresh-cw" class="w-3.5 h-3.5 mr-2 shrink-0" />
                      Scan for new files
                    </.dropdown_menu_item>
                    <.dropdown_menu_item
                      class="hover:bg-gray-700 focus:bg-gray-700 cursor-pointer"
                      on-select={JS.push("sidebar_force_scan", value: %{id: lib.id})}
                    >
                      <.icon name="lucide-rotate-ccw" class="w-3.5 h-3.5 mr-2 shrink-0" />
                      Force rescan
                    </.dropdown_menu_item>
                    <.dropdown_menu_separator class="bg-gray-700" />
                    <.dropdown_menu_item class="hover:bg-gray-700 focus:bg-gray-700">
                      <a href="/admin" class="flex items-center w-full">
                        <.icon name="lucide-settings" class="w-3.5 h-3.5 mr-2 shrink-0" />
                        Settings
                      </a>
                    </.dropdown_menu_item>
                  </.dropdown_menu_content>
                </.dropdown_menu>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </nav>
    </aside>
  <% end %>

  <%!-- Main area --%>
  <div class="flex-1 flex flex-col min-w-0">
    <%!-- Top header with search --%>
    <%= if Map.get(assigns, :current_user) do %>
      <% scan_progress = Map.get(assigns, :sidebar_scan_progress) || %{}

      active_tasks =
        scan_progress
        |> Enum.filter(fn {_id, t} -> not t.done end)
        |> Enum.map(fn {id, t} -> {id, t} end)

      lib_names =
        (Map.get(assigns, :sidebar_libraries) || []) |> Enum.into(%{}, fn l -> {l.id, l.name} end) %>
      <header class="flex items-center gap-4 px-4 py-3 border-b border-gray-800 bg-gray-900/50">
        <button
          onclick="toggleSidebar()"
          class="lg:hidden p-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-gray-800 transition-colors flex-shrink-0"
          aria-label="Toggle sidebar"
        >
          <.icon name="lucide-menu" class="w-5 h-5" />
        </button>

        <form action="/search" method="get" class="flex-1 max-w-xl">
          <div class="relative">
            <.icon
              name="lucide-search"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500"
            />
            <input
              type="search"
              name="q"
              placeholder="Search titles, series, publishers..."
              class="w-full bg-gray-800 border border-gray-700 rounded-lg pl-9 pr-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-violet-500"
            />
          </div>
        </form>

        <div class="ml-auto flex items-center gap-2">
          <%!-- Activity indicator dropdown --%>
          <.dropdown_menu id="activity-menu">
            <.dropdown_menu_trigger class={"relative p-1.5 rounded-lg transition-colors hover:bg-gray-800 flex items-center justify-center #{if active_tasks != [], do: "text-violet-400", else: "text-gray-500"}"}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={if active_tasks != [], do: "animate-pulse"}
              >
                <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
              </svg>
              <%= if active_tasks != [] do %>
                <span class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-violet-500 rounded-full animate-ping"></span>
              <% end %>
            </.dropdown_menu_trigger>
            <.dropdown_menu_content align="end" class="w-72 bg-gray-800 border-gray-700 p-0">
              <div class="px-3 py-2 border-b border-gray-700">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                  Background Tasks
                </p>
              </div>
              <%= if active_tasks == [] do %>
                <div class="px-3 py-4 text-center">
                  <p class="text-sm text-gray-500">No active tasks</p>
                </div>
              <% else %>
                <%= for {lib_id, task} <- active_tasks do %>
                  <% name = Map.get(lib_names, lib_id, "Library")
                  pct = if task.total > 0, do: round(task.scanned / task.total * 100), else: nil %>
                  <div class="px-3 py-2.5 border-b border-gray-700/60 last:border-0">
                    <div class="flex items-center justify-between mb-1.5">
                      <div class="flex items-center gap-2 min-w-0">
                        <.icon
                          name="lucide-loader-circle"
                          class="w-3 h-3 text-violet-400 animate-spin flex-shrink-0"
                        />
                        <div class="min-w-0">
                          <span class="text-sm text-gray-300 truncate block">{name}</span>
                          <span class="text-[10px] text-gray-500">{if Map.get(task, :phase) ==
                                                                        :thumbnails,
                                                                      do: "Generating covers",
                                                                      else: "Scanning files"}</span>
                        </div>
                      </div>
                      <%= if pct do %>
                        <span class="text-xs text-violet-400 font-mono ml-2 flex-shrink-0">{pct}%</span>
                      <% end %>
                    </div>
                    <div class="w-full bg-gray-700 rounded-full h-1">
                      <%= if pct do %>
                        <div
                          class="bg-violet-500 h-1 rounded-full transition-all duration-300"
                          style={"width: #{pct}%"}
                        >
                        </div>
                      <% else %>
                        <div class="bg-violet-500/60 h-1 rounded-full w-1/3 animate-pulse"></div>
                      <% end %>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">{task.scanned} / {task.total} files</p>
                  </div>
                <% end %>
              <% end %>
            </.dropdown_menu_content>
          </.dropdown_menu>

          <div class="w-px h-5 bg-gray-700 flex-shrink-0"></div>

          <%!-- User menu dropdown --%>
          <.dropdown_menu id="user-menu">
            <.dropdown_menu_trigger class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-gray-800 transition-colors">
              <div class="w-7 h-7 rounded-full bg-violet-700 flex items-center justify-center text-xs font-bold text-white">
                {String.upcase(String.first(@current_user.username || "?"))}
              </div>
              <span class="hidden sm:block text-sm text-gray-300">{@current_user.username}</span>
              <.icon name="lucide-chevron-down" class="w-3.5 h-3.5 text-gray-500" />
            </.dropdown_menu_trigger>
            <.dropdown_menu_content align="end" class="w-48 bg-gray-800 border-gray-700">
              <%= if @current_user.role == :admin do %>
                <.dropdown_menu_item class="hover:bg-gray-700 focus:bg-gray-700">
                  <a href="/admin" class="flex items-center gap-2.5 w-full">
                    <.icon name="lucide-settings" class="w-4 h-4 shrink-0" /> System Settings
                  </a>
                </.dropdown_menu_item>
              <% end %>
              <.dropdown_menu_item class="hover:bg-gray-700 focus:bg-gray-700 p-0">
                <form action="/logout" method="post" class="w-full">
                  <input type="hidden" name="_method" value="delete" />
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <button
                    type="submit"
                    class="flex w-full items-center gap-2.5 px-2 py-1.5 text-sm text-gray-300"
                  >
                    <.icon name="lucide-log-out" class="w-4 h-4 shrink-0" /> Sign Out
                  </button>
                </form>
              </.dropdown_menu_item>
            </.dropdown_menu_content>
          </.dropdown_menu>
        </div>
      </header>
    <% end %>

    <main class="flex-1 overflow-auto">
      <.flash_group flash={@flash} />
      <div class="px-6 py-6">
        {@inner_content}
      </div>
    </main>
  </div>
</div>

<script>
  function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    sidebar.classList.toggle('-translate-x-full');
    backdrop.classList.toggle('hidden');
  }
  function closeSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    sidebar.classList.add('-translate-x-full');
    backdrop.classList.add('hidden');
  }
</script>

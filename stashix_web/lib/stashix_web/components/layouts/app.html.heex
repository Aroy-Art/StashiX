--%>

<% user = Map.get(assigns, :current_user) %>
<div
  class="flex h-screen h-dvh overflow-hidden bg-canvas text-fg"
  data-read-mark={user && Stashix.Accounts.User.ui_setting(user, "read_mark")}
  data-data-saver={user && Stashix.Accounts.User.ui_setting(user, "data_saver")}
>
  <%!-- Mobile backdrop --%>
  <%= if Map.get(assigns, :current_user) do %>
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 bg-black/60 z-30 hidden lg:hidden"
      onclick="closeSidebar()"
    >
    </div>

    <%!-- Sidebar --%>
    <aside
      id="sidebar"
      phx-hook="Sidebar"
      class="fixed inset-y-0 left-0 z-40 w-48 max-w-[85vw] lg:w-52 -translate-x-full lg:translate-x-0 lg:relative lg:z-auto flex-shrink-0 bg-canvas border-r border-fg/10 flex flex-col h-screen h-dvh transition-transform duration-200"
    >
      <%!-- Logo --%>
      <%!-- Centred by eye rather than by box: the trail hangs outside the word,
           so most of its width is added on the right. That balances the pair
           and keeps the tip of the trail inside the sidebar. --%>
      <%!-- The logo block and the top bar stay dark in every theme: one dark band. --%>
      <div class="scheme-dark flex items-center justify-center h-16 bg-band border-b border-fg/10">
        <.link navigate="/" class="flex items-center text-[2.125rem] pr-[1.45em]" aria-label={gettext("Stashix home")}>
          <.logo id="sidebar-logo" />
        </.link>
      </div>

      <% path = Map.get(assigns, :current_path) %>
      <%= if Map.get(assigns, :admin_sidebar) do %>
        <%!-- Admin Nav --%>
        <nav class="flex-1 p-2 space-y-0.5 overflow-y-auto" aria-label={gettext("Admin")}>
          <.eyebrow class="px-3 pt-2 pb-1.5">{gettext("Admin")}</.eyebrow>
          <.nav_item
            :for={
              {label, to, icon} <- [
                {gettext("Users"), "/admin/users", "lucide-users"},
                {gettext("Libraries"), "/admin/libraries", "lucide-folder"},
                {gettext("Cleanup"), "/admin/cleanup", "lucide-trash"},
                {gettext("Publishers"), "/admin/publishers", "lucide-building"},
                {gettext("Health"), "/admin/health", "lucide-heart-pulse"},
                {gettext("Metadata"), "/admin/metadata", "lucide-database-zap"}
              ]
            }
            navigate={to}
            icon={icon}
            active={under?(path, to)}
          >
            {label}
          </.nav_item>

          <div class="mt-3 pt-3 border-t border-fg/10">
            <.nav_item navigate="/" icon="lucide-arrow-left">{gettext("Back to library")}</.nav_item>
          </div>
        </nav>
      <% else %>
        <%!-- Main Nav --%>
        <nav class="flex-1 p-2 space-y-0.5 overflow-y-auto" aria-label={gettext("Main")}>
          <.nav_item
            :for={
              {label, to, icon} <- [
                {gettext("Home"), "/", "lucide-house"},
                {gettext("Search"), "/search", "lucide-search"},
                {gettext("Series"), "/series", "lucide-book-copy"},
                {gettext("Books"), "/books", "lucide-library-big"},
                {gettext("Issues"), "/issues", "lucide-layers"},
                {gettext("Publishers"), "/publishers", "lucide-building"},
                {gettext("Stats"), "/stats", "lucide-chart-bar"}
              ]
            }
            navigate={to}
            icon={icon}
            active={under?(path, to) or (to == "/publishers" and under?(path, "/publisher"))}
          >
            {label}
          </.nav_item>

          <%!-- Libraries section in sidebar --%>
          <%= if Map.get(assigns, :sidebar_libraries) do %>
            <.eyebrow class="px-3 pt-5 pb-1.5">{gettext("Libraries")}</.eyebrow>
            <%= for lib <- @sidebar_libraries do %>
              <% progress = Map.get(assigns[:sidebar_scan_progress] || %{}, lib.id)

              pct =
                if progress && progress.total > 0,
                  do: round(progress.scanned / progress.total * 100),
                  else: nil

              scanning = not is_nil(progress) %>
              <div class="flex items-center">
                <.nav_item
                  navigate={"/library/#{slug_param(lib)}"}
                  icon={if scanning, do: "lucide-loader-circle", else: "lucide-folder"}
                  icon_class={if scanning, do: "animate-spin text-ink"}
                  active={under?(path, "/library/#{slug_param(lib)}")}
                  class="flex-1"
                >
                  <span class="truncate">{lib.name}</span>
                  <span :if={pct} class="ml-auto text-sm text-ink tabular-nums shrink-0">{pct}%</span>
                </.nav_item>
                <.library_menu
                  :if={@current_user.role == :admin}
                  id={"lib-menu-#{lib.id}"}
                  library_id={lib.id}
                  class="ml-0.5 shrink-0"
                />
              </div>
            <% end %>
          <% end %>
        </nav>
      <% end %>

      <%!-- Theme menu, saved to the account. --%>
      <% theme = Stashix.Accounts.User.ui_setting(@current_user, "theme")

      themes = [
        {"system", gettext("System"), "lucide-sun-moon"},
        {"light", gettext("Light"), "lucide-sun"},
        {"dark", gettext("Dark"), "lucide-moon"}
      ]

      {_, theme_label, theme_icon} = List.keyfind(themes, theme, 0) %>
      <div class="p-2 border-y border-fg/10">
        <.ink_menu id="theme-menu" align="start" class="flex w-full" panel_class="w-44">
          <:trigger
            label={gettext("Theme: %{theme}", theme: theme_label)}
            class="flex items-center gap-3 w-full px-3 py-2 rounded-sm font-display font-bold uppercase tracking-[0.07em] text-sm text-muted hover:text-fg hover:bg-fg/[0.06] transition-colors"
          >
            <.icon name={theme_icon} class="w-4 h-4" />
            <span>{gettext("Theme")}</span>
            <span class="ml-auto text-faint">{theme_label}</span>
          </:trigger>
          <.menu_label>{gettext("Theme")}</.menu_label>
          <.menu_item
            :for={{value, label, icon} <- themes}
            id={"theme-#{value}"}
            icon={icon}
            active={theme == value}
            phx-click="set_theme"
            phx-value-theme={value}
          >
            {label}
          </.menu_item>
        </.ink_menu>
      </div>

      <%!-- Version and source link (AGPL: the source is one click away). --%>
      <div class="flex items-center justify-between gap-2 px-5 py-1.5 text-[11px] leading-none text-faint">
        <span id="app-version" class="tabular-nums">{app_version()}</span>
        <a
          id="sidebar-source-link"
          href={source_url()}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 hover:text-fg transition-colors"
        >
          <.icon name="lucide-code-xml" class="w-3 h-3" /> {gettext("Source")}
        </a>
      </div>
    </aside>
  <% end %>

  <%!-- Main area --%>
  <div class="flex-1 flex flex-col min-w-0">
    <%!-- Top header with search --%>
    <%= if Map.get(assigns, :current_user) do %>
      <% scan_progress = Map.get(assigns, :sidebar_scan_progress) || %{}
      health_progress = Map.get(assigns, :sidebar_health_progress) || %{}

      scan_tasks = Enum.map(scan_progress, fn {id, t} -> {id, Map.put(t, :source, :scan)} end)

      health_tasks =
        health_progress
        |> Enum.map(fn {id, t} -> {"health:#{id}", Map.put(t, :library_id, id)} end)

      active_tasks =
        (scan_tasks ++ health_tasks)
        |> Enum.filter(fn {_id, t} -> not t.done end)

      all_tasks = scan_tasks ++ health_tasks

      lib_names =
        (Map.get(assigns, :sidebar_libraries) || []) |> Enum.into(%{}, fn l -> {l.id, l.name} end) %>
      <header class="app-bar scheme-dark relative flex items-center h-16 gap-4 px-4 bg-band">
        <button
          onclick="toggleSidebar()"
          class="lg:hidden p-1.5 rounded-md text-muted hover:text-fg hover:bg-fg/10 transition-colors flex-shrink-0"
          aria-label={gettext("Toggle sidebar")}
        >
          <.icon name="lucide-menu" class="w-5 h-5" />
        </button>

        <% navbar_query = Map.get(assigns, :navbar_search_query, "")
        navbar_results = Map.get(assigns, :navbar_search_results, [])
        # Set by pages (the search page) that mirror the navbar box into their own query.
        navbar_sync_query = Map.get(assigns, :navbar_sync_query) %>
        <form
          action="/search"
          method="get"
          phx-submit={navbar_sync_query && "navbar_submit"}
          class="flex-1 max-w-xl"
        >
          <div class="relative group">
            <.icon
              name="lucide-search"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted group-focus-within:text-ink transition-colors"
            />
            <input
              id="navbar-search-input"
              type="search"
              name="q"
              value={navbar_sync_query}
              phx-keyup="navbar_search"
              phx-debounce="200"
              phx-blur="navbar_search_clear"
              phx-hook="SearchNav"
              placeholder={gettext("Search titles, series, publishers...")}
              class="nav-search w-full pl-9 pr-4 sm:pr-20 py-2 text-sm text-fg placeholder-faint"
              autocomplete="off"
            />
            <span
              :if={!navbar_sync_query}
              class="absolute right-2.5 top-1/2 -translate-y-1/2 hidden sm:block group-focus-within:opacity-0 transition-opacity duration-100"
            >
              <.kbd keys={["Ctrl", "K"]} />
            </span>
            <%= if navbar_query != "" && navbar_results != [] do %>
              <div
                class="ink-menu fixed top-16 mt-2 left-2 right-3 z-50 sm:absolute sm:top-full sm:left-0 sm:right-0 p-1.5 rounded-md bg-raised ring-1 ring-edge"
                onmousedown="event.preventDefault()"
              >
                <div class="overflow-y-auto max-h-[480px]">
                  <%= for result <- navbar_results do %>
                    <.link
                      data-result
                      navigate={
                        if result.type == :series,
                          do: ~p"/series/#{slug_param(result)}",
                          else: ~p"/book/#{slug_param(result)}"
                      }
                      class="ink-menu-item flex items-center gap-3 px-2 py-1.5 rounded-sm text-sm text-fg-soft hover:bg-fg/[0.05] focus:bg-fg/[0.07] outline-none transition-colors"
                    >
                      <div class="w-8 h-11 flex-shrink-0 rounded-sm overflow-hidden bg-raised">
                        <%= if result.cover do %>
                          <img
                            src={
                              if result.type == :series,
                                do: ~p"/api/series/#{result.id}/cover",
                                else: ~p"/api/books/#{result.id}/cover"
                            }
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        <% else %>
                          <div class="w-full h-full flex items-center justify-center">
                            <.icon name="lucide-image-off" class="w-4 h-4 text-muted" />
                          </div>
                        <% end %>
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="truncate text-fg-soft leading-tight">{result.label}</p>
                        <%= if result.sub do %>
                          <p class="text-xs text-muted mt-0.5">{result.sub}</p>
                        <% end %>
                      </div>
                      <.eyebrow tag="span" size="xs" tone="muted" class="shrink-0">
                        {result_type_label(result.type)}
                      </.eyebrow>
                    </.link>
                  <% end %>
                </div>
                <.link
                  navigate={~p"/search?#{[q: navbar_query]}"}
                  class="ink-menu-item flex items-center justify-center gap-2 mt-1.5 px-2 py-2 rounded-sm border-t border-fg/10 font-display font-bold uppercase tracking-wide text-sm text-fg-soft hover:text-fg hover:bg-fg/[0.05] focus:bg-fg/[0.07] outline-none transition-colors"
                >
                  {gettext("See all results for \"%{query}\"", query: navbar_query)}
                  <.icon name="lucide-arrow-right" class="w-3.5 h-3.5 text-ink" />
                </.link>
              </div>
            <% end %>
          </div>
        </form>

        <div class="ml-auto flex items-center gap-2">
          <%!-- Activity indicator dropdown --%>
          <.ink_menu id="activity-menu" panel_class="w-72">
            <:trigger
              label={gettext("Background tasks")}
              class={[
                "relative p-1.5 rounded-lg transition-colors hover:bg-fg/10 flex items-center justify-center",
                if(active_tasks != [], do: "text-ink", else: "text-muted hover:text-fg")
              ]}
            >
              <.icon name="lucide-activity" class={"w-4 h-4 #{if active_tasks != [], do: "animate-pulse"}"} />
              <span
                :if={active_tasks != []}
                class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-ink rounded-full animate-ping"
              ></span>
            </:trigger>
            <.menu_label>{gettext("Background tasks")}</.menu_label>
            <p :if={all_tasks == []} class="px-2 pt-1 pb-2 text-sm text-muted">{gettext("Nothing running")}</p>
            <div
              :for={{task_id, task} <- all_tasks}
              id={"task-#{task_id}"}
              class="px-2 py-2 border-t border-fg/10 first-of-type:border-t-0"
            >
              <% is_health = Map.has_key?(task, :type)
              lib_id = if is_health, do: task.library_id, else: task_id
              done = task.done

              {progress, total} =
                if is_health,
                  do: {task.checked, task.total},
                  else: {Map.get(task, :scanned, 0), task.total}

              pct = if total > 0, do: progress / total %>
              <div class="flex items-center justify-between gap-3">
                <span class="min-w-0 truncate font-display font-bold uppercase tracking-wide text-sm text-fg">
                  {Map.get(lib_names, lib_id, gettext("Library"))}
                </span>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <span class="font-display font-black text-lg leading-none tabular-nums text-ink">
                    {cond do
                      done -> gettext("Done")
                      pct -> "#{round(pct * 100)}%"
                      true -> "…"
                    end}
                  </span>
                  <button
                    :if={!done}
                    phx-click={if is_health, do: "cancel_health_scan", else: "cancel_scan"}
                    phx-value-id={lib_id}
                    title={gettext("Cancel")}
                    class="p-0.5 rounded text-faint hover:text-danger hover:bg-fg/10 transition-colors"
                  >
                    <.icon name="lucide-x" class="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>
              <p class="mt-0.5 mb-2 text-[11px] text-muted">
                {cond do
                  done and is_health -> gettext("Health check complete")
                  done and Map.get(task, :phase) == :cancelled -> gettext("Cancelled")
                  done -> gettext("Complete")
                  is_health and task.type == :integrity -> gettext("Checking archive integrity")
                  is_health and task.type == :unsupported -> gettext("Scanning for unsupported files")
                  Map.get(task, :phase) == :thumbnails -> gettext("Generating covers")
                  Map.get(task, :phase) == :file -> gettext("Indexing new file")
                  true -> gettext("Scanning files")
                end}
                <span :if={!done and total > 0} class="tabular-nums"> · {gettext("%{done} / %{total} files",
                  done: progress,
                  total: total
                )}</span>
              </p>
              <.run_bar
                value={if done, do: 1.0, else: pct}
                label={gettext("%{library} progress", library: Map.get(lib_names, lib_id, gettext("Library")))}
              />
            </div>
            <%!-- Scans waiting for a running library or series scan (admins only) --%>
            <% scan_queue =
              if @current_user.role == :admin, do: Map.get(assigns, :sidebar_scan_queue) || %{}, else: %{} %>
            <%= if scan_queue != %{} do %>
              <.menu_label class="border-t border-fg/10 pt-2">{gettext("Queued")}</.menu_label>
              <div :for={{lib_id, items} <- scan_queue} id={"scan-queue-#{lib_id}"} class="px-2 pb-2">
                <div class="flex items-center justify-between gap-3">
                  <span class="min-w-0 truncate font-display font-bold uppercase tracking-wide text-sm text-fg">
                    {Map.get(lib_names, lib_id, gettext("Library"))}
                  </span>
                  <span class="font-display font-black text-sm leading-none tabular-nums text-muted">
                    {length(items)}
                  </span>
                </div>
                <ul class="mt-1 space-y-0.5">
                  <li
                    :for={item <- Enum.take(items, 5)}
                    class="flex items-center gap-2 text-[11px] text-muted min-w-0"
                  >
                    <.icon
                      name={
                        case item.kind do
                          :library -> "lucide-refresh-cw"
                          :series -> "lucide-library"
                          :file -> "lucide-file"
                        end
                      }
                      class="w-3 h-3 flex-shrink-0 text-faint"
                    />
                    <span class="truncate">
                      {case item.kind do
                        :library ->
                          if item.force, do: gettext("Force scan"), else: gettext("Scan")

                        :series ->
                          "#{if item.force, do: gettext("Force rescan"), else: gettext("Rescan")} · #{item.label}"

                        :file ->
                          item.label
                      end}
                    </span>
                  </li>
                  <li :if={length(items) > 5} class="pl-5 text-[11px] text-faint">
                    {gettext("+%{count} more", count: length(items) - 5)}
                  </li>
                </ul>
              </div>
            <% end %>
          </.ink_menu>

          <div class="w-px h-5 bg-fg/15 flex-shrink-0"></div>

          <%!-- User menu dropdown --%>
          <.ink_menu id="user-menu" class="group">
            <:trigger class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-fg/10 transition-colors">
              <div class="w-7 h-7 rounded-full bg-violet-700 flex items-center justify-center text-xs font-bold text-white">
                {String.upcase(String.first(@current_user.display_name || @current_user.username || "?"))}
              </div>
              <span class="hidden sm:block text-sm text-fg-soft">
                {@current_user.display_name || @current_user.username}
              </span>
              <.icon
                name="lucide-chevron-down"
                class="w-3.5 h-3.5 text-muted transition-transform group-data-[open]:rotate-180"
              />
            </:trigger>
            <.menu_item icon="lucide-sliders-horizontal" navigate="/settings">{gettext("Settings")}</.menu_item>
            <.menu_item :if={@current_user.role == :admin} icon="lucide-settings" navigate="/admin/users">
              {gettext("System settings")}
            </.menu_item>
            <.menu_item icon="lucide-log-out" href="/logout" method="delete">{gettext("Sign out")}</.menu_item>
          </.ink_menu>
        </div>
      </header>
    <% end %>

    <main class="flex-1 overflow-auto">
      <.flash_group flash={@flash} />
      <div class="px-6 py-6 xl:px-12 2xl:px-20">
        {@inner_content}
      </div>
    </main>
  </div>
</div>

<div class="flex h-screen overflow-hidden bg-gray-950 text-gray-100">
  <%# Sidebar %>
  <%= if Map.get(assigns, :current_user) do %>
  <aside class="w-52 flex-shrink-0 bg-gray-900 border-r border-gray-800 flex flex-col h-screen">
    <%# Logo %>
    <div class="p-4 border-b border-gray-800">
      <a href="/" class="flex items-center gap-2">
        <div class="w-8 h-8 bg-violet-600 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <span class="text-white font-bold text-lg">Stashix</span>
      </a>
    </div>

    <%# Nav %>
    <nav class="flex-1 p-2 overflow-y-auto">
      <a href="/" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>

      <a href="/search" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Search
      </a>

      <a href="/books" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors mb-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        All Books
      </a>

      <%# Libraries section in sidebar %>
      <%= if Map.get(assigns, :sidebar_libraries) do %>
        <div class="mt-4 mb-1 px-3">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Libraries</p>
        </div>
        <%= for lib <- @sidebar_libraries do %>
          <a href={"/library/#{lib.id}"} class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition-colors mb-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" />
            </svg>
            <span class="truncate">{lib.name}</span>
          </a>
        <% end %>
      <% end %>
    </nav>

    <%# User + sign out %>
    <div class="p-3 border-t border-gray-800">
      <%= if Map.get(assigns, :current_user) do %>
        <div class="flex items-center gap-2 px-2 py-2 mb-1">
          <div class="w-7 h-7 rounded-full bg-violet-700 flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
            {String.upcase(String.first(@current_user.username || "?"))}
          </div>
          <span class="text-sm text-gray-300 truncate">{@current_user.username}</span>
        </div>
      <% end %>
      <form action="/logout" method="post">
        <input type="hidden" name="_method" value="delete" />
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button type="submit" class="flex w-full items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 hover:bg-gray-800 hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sign Out
        </button>
      </form>
    </div>
  </aside>
  <% end %>

  <%# Main area %>
  <div class="flex-1 flex flex-col min-w-0">
    <%# Top header with search %>
    <header class="flex items-center gap-4 px-6 py-3 border-b border-gray-800 bg-gray-900/50">
      <form action="/search" method="get" class="flex-1 max-w-xl">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search titles, series, publishers..."
            class="w-full bg-gray-800 border border-gray-700 rounded-lg pl-9 pr-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-violet-500"
          />
        </div>
      </form>

      <%= if Map.get(assigns, :current_user) && @current_user.role == :admin do %>
        <a href="/admin" class="text-sm text-gray-400 hover:text-white">Admin</a>
      <% end %>
    </header>

    <main class="flex-1 overflow-auto">
      <.flash_group flash={@flash} />
      <div class="px-6 py-6">
        {@inner_content}
      </div>
    </main>
  </div>
</div>

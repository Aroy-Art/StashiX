<div class="flex h-screen h-dvh overflow-hidden bg-gray-950 text-gray-100">
  <%!-- Mobile backdrop --%>
  <%= if Map.get(assigns, :current_user) do %>
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 bg-black/60 z-30 hidden lg:hidden"
      onclick="closeSidebar()"
    >
    </div>

    <%!-- Sidebar --%>
    <aside
      id="sidebar"
      class="fixed inset-y-0 left-0 z-40 w-52 -translate-x-full lg:translate-x-0 lg:relative lg:z-auto flex-shrink-0 bg-gray-950 border-r-2 border-gray-800 flex flex-col h-screen h-dvh transition-transform duration-200"
    >
      <%!-- Logo --%>
      <div class="flex items-center h-16 ps-6 border-b-2 border-gray-800">
        <a href="/" class="flex items-center">
          <span class="font-bold text-2xl relative">
            <span class="text-white">Stash</span><span class="text-violet-500 [text-shadow:3px_0_18px_rgba(167,139,250,0.9),6px_0_28px_rgba(139,92,246,0.5),0_0_6px_rgba(167,139,250,0.7)]">iX</span>
            <svg class="absolute left-full translate-x-0.5 top-1/2 -translate-y-[38%] pointer-events-none" width="50" height="18" viewBox="0 0 50 18" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="ix-trail" x1="0" y1="0" x2="50" y2="0" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#a78bfa" stop-opacity="0.85"/>
                  <stop offset="60%" stop-color="#a78bfa" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="#a78bfa" stop-opacity="0"/>
                </linearGradient>
                <filter id="ix-glow" x="-30%" y="-150%" width="200%" height="400%">
                  <feGaussianBlur stdDeviation="2.5" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <path d="M1 13 C16 13, 36 11, 49 2" stroke="url(#ix-trail)" stroke-width="3" stroke-linecap="round" filter="url(#ix-glow)"/>
              <path d="M1 13 C14 13, 30 11, 44 5" stroke="url(#ix-trail)" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
            </svg>
          </span>
        </a>
      </div>

      <%= if Map.get(assigns, :admin_sidebar) do %>
        <%!-- Admin Nav --%>
        <% live_action = Map.get(assigns, :live_action) %>
        <nav class="flex-1 p-2 overflow-y-auto">
          <div class="mb-3 px-3 pt-1">
            <p class="text-xs font-semibold text-violet-500/70 uppercase tracking-wider">Admin</p>
          </div>

          <a
            href="/admin/users"
            class={[
              "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors mb-1",
              if(live_action == :users,
                do: "bg-violet-900/30 text-violet-200",
                else: "text-gray-400 hover:bg-violet-900/20 hover:text-violet-200"
              )
            ]}
          >
            <.icon name="lucide-users" class="w-4 h-4" /> Users
          </a>

          <a
            href="/admin/libraries"
            class={[
              "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors mb-1",
              if(live_action == :libraries,
                do: "bg-violet-900/30 text-violet-200",
                else: "text-gray-400 hover:bg-violet-900/20 hover:text-violet-200"
              )
            ]}
          >
            <.icon name="lucide-folder" class="w-4 h-4" /> Libraries
          </a>

          <a
            href="/admin/cleanup"
            class={[
              "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors mb-1",
              if(live_action == :cleanup,
                do: "bg-violet-900/30 text-violet-200",
                else: "text-gray-400 hover:bg-violet-900/20 hover:text-violet-200"
              )
            ]}
          >
            <.icon name="lucide-trash-2" class="w-4 h-4" /> Cleanup
          </a>

          <a
            href="/admin/publishers"
            class={[
              "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors mb-1",
              if(live_action == :publishers,
                do: "bg-violet-900/30 text-violet-200",
                else: "text-gray-400 hover:bg-violet-900/20 hover:text-violet-200"
              )
            ]}
          >
            <.icon name="lucide-building-2" class="w-4 h-4" /> Publishers
          </a>

          <div class="mt-4 mb-1 border-t border-gray-800 pt-3">
            <a
              href="/"
              class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 hover:bg-violet-900/20 hover:text-violet-200 transition-colors"
            >
              <.icon name="lucide-arrow-left" class="w-4 h-4" /> Back to Library
            </a>
          </div>
        </nav>
      <% else %>
        <%!-- Main Nav --%>
        <nav class="flex-1 p-2 overflow-y-auto">
          <a
            href="/"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors mb-1"
          >
            <.icon name="lucide-house" class="w-4 h-4" /> Home
          </a>

          <a
            href="/search"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors mb-1"
          >
            <.icon name="lucide-search" class="w-4 h-4" /> Search
          </a>

          <a
            href="/books"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors mb-1"
          >
            <.icon name="lucide-library-big" class="w-4 h-4" /> Books
          </a>

          <a
            href="/issues"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors mb-1"
          >
            <.icon name="lucide-layers" class="w-4 h-4" /> Issues
          </a>

          <a
            href="/series"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors mb-1"
          >
            <.icon name="lucide-book-copy" class="w-4 h-4" /> Series
          </a>

          <a
            href="/publishers"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors mb-1"
          >
            <.icon name="lucide-building-2" class="w-4 h-4" /> Publishers
          </a>

          <%!-- Libraries section in sidebar --%>
          <%= if Map.get(assigns, :sidebar_libraries) do %>
            <div class="mt-4 mb-1 px-3">
              <p class="text-xs font-semibold text-violet-500/70 uppercase tracking-wider">Libraries</p>
            </div>
            <%= for lib <- @sidebar_libraries do %>
              <% progress = Map.get(assigns[:sidebar_scan_progress] || %{}, lib.id)

              pct =
                if progress && progress.total > 0,
                  do: round(progress.scanned / progress.total * 100),
                  else: nil

              scanning = not is_nil(progress) %>
              <div class="relative group/lib flex items-center mb-1">
                <a
                  href={"/library/#{lib.id}"}
                  class="flex-1 flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-violet-900/20 hover:text-violet-200 transition-colors min-w-0"
                >
                  <.icon
                    name={if scanning, do: "lucide-loader-circle", else: "lucide-folder"}
                    class={
                      if scanning,
                        do: "w-4 h-4 shrink-0 animate-spin text-violet-400",
                        else: "w-4 h-4 shrink-0"
                    }
                  />
                  <span class="truncate">{lib.name}</span>
                  <%= if pct do %>
                    <span class="ml-auto text-[10px] font-mono text-violet-400 shrink-0">{pct}%</span>
                  <% end %>
                </a>
                <%= if @current_user.role == :admin do %>
                  <.dropdown_menu id={"lib-menu-#{lib.id}"} use-portal={true}>
                    <.dropdown_menu_trigger class="p-1.5 rounded text-gray-600 hover:text-violet-300 hover:bg-violet-900/30 transition-all mr-1 shrink-0">
                      <.icon name="lucide-ellipsis-vertical" class="w-3.5 h-3.5" />
                    </.dropdown_menu_trigger>
                    <.dropdown_menu_content class="bg-gray-800 border-gray-700 text-gray-300 whitespace-nowrap">
                      <.dropdown_menu_item
                        class="hover:bg-gray-700 focus:bg-gray-700 cursor-pointer"
                        on-select={JS.push("sidebar_scan", value: %{id: lib.id})}
                      >
                        <.icon name="lucide-refresh-cw" class="w-3.5 h-3.5 mr-2 shrink-0" />
                        Scan for new files
                      </.dropdown_menu_item>
                      <.dropdown_menu_item
                        class="hover:bg-gray-700 focus:bg-gray-700 cursor-pointer"
                        on-select={JS.push("sidebar_force_scan", value: %{id: lib.id})}
                      >
                        <.icon name="lucide-rotate-ccw" class="w-3.5 h-3.5 mr-2 shrink-0" />
                        Force rescan
                      </.dropdown_menu_item>
                      <.dropdown_menu_separator class="bg-gray-700" />
                      <.dropdown_menu_link_item href="/admin/libraries" class="hover:bg-gray-700 focus:bg-gray-700">
                        <.icon name="lucide-settings" class="w-3.5 h-3.5 mr-2 shrink-0" />
                        Settings
                      </.dropdown_menu_link_item>
                    </.dropdown_menu_content>
                  </.dropdown_menu>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </nav>
      <% end %>
    </aside>
  <% end %>

  <%!-- Main area --%>
  <div class="flex-1 flex flex-col min-w-0">
    <%!-- Top header with search --%>
    <%= if Map.get(assigns, :current_user) do %>
      <% scan_progress = Map.get(assigns, :sidebar_scan_progress) || %{}

      active_tasks =
        scan_progress
        |> Enum.filter(fn {_id, t} -> not t.done end)
        |> Enum.map(fn {id, t} -> {id, t} end)

      all_tasks =
        scan_progress
        |> Enum.map(fn {id, t} -> {id, t} end)

      lib_names =
        (Map.get(assigns, :sidebar_libraries) || []) |> Enum.into(%{}, fn l -> {l.id, l.name} end) %>
      <header class="flex items-center h-16 gap-4 px-4 border-b-2 border-gray-800 bg-gray-950">
        <button
          onclick="toggleSidebar()"
          class="lg:hidden p-1.5 rounded-lg text-gray-400 hover:text-violet-200 hover:bg-violet-900/20 transition-colors flex-shrink-0"
          aria-label="Toggle sidebar"
        >
          <.icon name="lucide-menu" class="w-5 h-5" />
        </button>

        <form action="/search" method="get" class="flex-1 max-w-xl">
          <div class="relative">
            <.icon
              name="lucide-search"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500"
            />
            <input
              type="search"
              name="q"
              placeholder="Search titles, series, publishers..."
              class="w-full bg-gray-900 border border-gray-800 rounded-lg pl-9 pr-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-violet-500/70 focus:bg-gray-900"
            />
          </div>
        </form>

        <div class="ml-auto flex items-center gap-2">
          <%!-- Activity indicator dropdown --%>
          <.dropdown_menu id="activity-menu">
            <.dropdown_menu_trigger class={"relative p-1.5 rounded-lg transition-colors hover:bg-violet-900/20 flex items-center justify-center #{if active_tasks != [], do: "text-violet-400", else: "text-gray-500 hover:text-violet-300"}"}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class={if active_tasks != [], do: "animate-pulse"}
              >
                <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
              </svg>
              <%= if active_tasks != [] do %>
                <span class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-violet-500 rounded-full animate-ping"></span>
              <% end %>
            </.dropdown_menu_trigger>
            <.dropdown_menu_content align="end" class="w-72 bg-gray-800 border-gray-700 p-0">
              <div class="px-3 py-2 border-b border-gray-700">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                  Background Tasks
                </p>
              </div>
              <%= if all_tasks == [] do %>
                <div class="px-3 py-4 text-center">
                  <p class="text-sm text-gray-500">No active tasks</p>
                </div>
              <% else %>
                <%= for {lib_id, task} <- all_tasks do %>
                  <% name = Map.get(lib_names, lib_id, "Library")
                  pct = if task.total > 0, do: round(task.scanned / task.total * 100), else: nil %>
                  <div id={"task-#{lib_id}"} class="px-3 py-2.5 border-b border-gray-700/60 last:border-0">
                    <div class="flex items-center justify-between mb-1.5">
                      <div class="flex items-center gap-2 min-w-0">
                        <%= if task.done do %>
                          <.icon name="lucide-check-circle" class="w-3 h-3 text-green-400 flex-shrink-0" />
                        <% else %>
                          <.icon name="lucide-loader-circle" class="w-3 h-3 text-violet-400 animate-spin flex-shrink-0" />
                        <% end %>
                        <div class="min-w-0">
                          <span class="text-sm text-gray-300 truncate block">{name}</span>
                          <span class="text-[10px] text-gray-500">{cond do
                            task.done -> "Complete"
                            Map.get(task, :phase) == :thumbnails -> "Generating covers"
                            Map.get(task, :phase) == :file -> "Indexing new file"
                            true -> "Scanning files"
                          end}</span>
                        </div>
                      </div>
                      <%= if pct && !task.done do %>
                        <span class="text-xs text-violet-400 font-mono ml-2 flex-shrink-0">{pct}%</span>
                      <% end %>
                    </div>
                    <%= if !task.done do %>
                      <div class="w-full bg-gray-700 rounded-full h-1">
                        <%= if pct do %>
                          <div
                            id={"task-bar-#{lib_id}"}
                            class="bg-violet-500 h-1 rounded-full transition-all duration-300"
                            style={"width: #{pct}%"}
                          >
                          </div>
                        <% else %>
                          <div class="bg-violet-500/60 h-1 rounded-full w-1/3 animate-pulse"></div>
                        <% end %>
                      </div>
                      <p class="text-xs text-gray-500 mt-1">{task.scanned} / {task.total} files</p>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </.dropdown_menu_content>
          </.dropdown_menu>

          <div class="w-px h-5 bg-gray-800 flex-shrink-0"></div>

          <%!-- User menu dropdown --%>
          <.dropdown_menu id="user-menu">
            <.dropdown_menu_trigger class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-violet-900/20 transition-colors">
              <div class="w-7 h-7 rounded-full bg-violet-700 flex items-center justify-center text-xs font-bold text-white">
                {String.upcase(String.first(@current_user.username || "?"))}
              </div>
              <span class="hidden sm:block text-sm text-gray-300">{@current_user.username}</span>
              <.icon name="lucide-chevron-down" class="w-3.5 h-3.5 text-gray-500" />
            </.dropdown_menu_trigger>
            <.dropdown_menu_content align="end" class="w-48 bg-gray-800 border-gray-700">
              <%= if @current_user.role == :admin do %>
                <.dropdown_menu_link_item href="/admin/users" class="hover:bg-gray-700 focus:bg-gray-700 gap-2.5">
                  <.icon name="lucide-settings" class="w-4 h-4 shrink-0" /> System Settings
                </.dropdown_menu_link_item>
              <% end %>
              <.dropdown_menu_item
                class="hover:bg-gray-700 focus:bg-gray-700 gap-2.5"
                on-select={JS.dispatch("submit", to: "#logout-form")}
              >
                <.icon name="lucide-log-out" class="w-4 h-4 shrink-0" /> Sign Out
              </.dropdown_menu_item>
            </.dropdown_menu_content>
          </.dropdown_menu>
        </div>
      </header>
    <% end %>

    <main class="flex-1 overflow-auto">
      <.flash_group flash={@flash} />
      <div class={unless Map.get(assigns, :full_bleed), do: "px-6 py-6"}>
        {@inner_content}
      </div>
    </main>
  </div>
</div>

<%!-- Hidden logout form triggered by user menu on-select --%>
<%= if Map.get(assigns, :current_user) do %>
  <form id="logout-form" action="/logout" method="post" class="hidden">
    <input type="hidden" name="_method" value="delete" />
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  </form>
<% end %>

<script>
  function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    sidebar.classList.toggle('-translate-x-full');
    backdrop.classList.toggle('hidden');
  }
  function closeSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    sidebar.classList.add('-translate-x-full');
    backdrop.classList.add('hidden');
  }
</script>

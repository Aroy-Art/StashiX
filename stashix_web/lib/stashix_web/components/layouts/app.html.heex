<div class="flex h-screen h-dvh overflow-hidden bg-gray-950 text-gray-100">
  <%!-- Mobile backdrop --%>
  <%= if Map.get(assigns, :current_user) do %>
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 bg-black/60 z-30 hidden lg:hidden"
      onclick="closeSidebar()"
    >
    </div>

    <%!-- Sidebar --%>
    <aside
      id="sidebar"
      phx-hook="Sidebar"
      class="fixed inset-y-0 left-0 z-40 w-48 max-w-[85vw] lg:w-52 -translate-x-full lg:translate-x-0 lg:relative lg:z-auto flex-shrink-0 bg-gray-950 border-r border-white/10 flex flex-col h-screen h-dvh transition-transform duration-200"
    >
      <%!-- Logo --%>
      <div class="flex items-center h-16 ps-5 border-b border-white/10">
        <.link navigate="/" class="flex items-center">
          <span class="font-bold text-2xl relative">
            <span class="text-white">Stash</span><span class="text-violet-500 [text-shadow:3px_0_18px_rgba(167,139,250,0.9),6px_0_28px_rgba(139,92,246,0.5),0_0_6px_rgba(167,139,250,0.7)]">iX</span>
            <svg
              class="absolute left-full translate-x-0.5 top-1/2 -translate-y-[38%] pointer-events-none"
              width="50"
              height="18"
              viewBox="0 0 50 18"
              fill="none"
              aria-hidden="true"
            >
              <defs>
                <linearGradient
                  id="ix-trail"
                  x1="0"
                  y1="0"
                  x2="50"
                  y2="0"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop offset="0%" stop-color="#a78bfa" stop-opacity="0.85" />
                  <stop offset="60%" stop-color="#a78bfa" stop-opacity="0.3" />
                  <stop offset="100%" stop-color="#a78bfa" stop-opacity="0" />
                </linearGradient>
                <filter id="ix-glow" x="-30%" y="-150%" width="200%" height="400%">
                  <feGaussianBlur stdDeviation="2.5" result="blur" />
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>
              <path
                d="M1 13 C16 13, 36 11, 49 2"
                stroke="url(#ix-trail)"
                stroke-width="3"
                stroke-linecap="round"
                filter="url(#ix-glow)"
              />
              <path
                d="M1 13 C14 13, 30 11, 44 5"
                stroke="url(#ix-trail)"
                stroke-width="1.2"
                stroke-linecap="round"
                opacity="0.8"
              />
            </svg>
          </span>
        </.link>
      </div>

      <% path = Map.get(assigns, :current_path) %>
      <%= if Map.get(assigns, :admin_sidebar) do %>
        <%!-- Admin Nav --%>
        <nav class="flex-1 p-2 space-y-0.5 overflow-y-auto" aria-label="Admin">
          <.eyebrow class="px-3 pt-2 pb-1.5">Admin</.eyebrow>
          <.nav_item
            :for={
              {label, to, icon} <- [
                {"Users", "/admin/users", "lucide-users"},
                {"Libraries", "/admin/libraries", "lucide-folder"},
                {"Cleanup", "/admin/cleanup", "lucide-trash"},
                {"Publishers", "/admin/publishers", "lucide-building"},
                {"Metadata", "/admin/metadata", "lucide-database-zap"}
              ]
            }
            navigate={to}
            icon={icon}
            active={under?(path, to)}
          >
            {label}
          </.nav_item>

          <div class="mt-3 pt-3 border-t border-white/10">
            <.nav_item navigate="/" icon="lucide-arrow-left">Back to library</.nav_item>
          </div>
        </nav>
      <% else %>
        <%!-- Main Nav --%>
        <nav class="flex-1 p-2 space-y-0.5 overflow-y-auto" aria-label="Main">
          <.nav_item
            :for={
              {label, to, icon} <- [
                {"Home", "/", "lucide-house"},
                {"Search", "/search", "lucide-search"},
                {"Series", "/series", "lucide-book-copy"},
                {"Books", "/books", "lucide-library-big"},
                {"Issues", "/issues", "lucide-layers"},
                {"Publishers", "/publishers", "lucide-building"},
                {"Stats", "/stats", "lucide-chart-bar"}
              ]
            }
            navigate={to}
            icon={icon}
            active={under?(path, to) or (to == "/publishers" and under?(path, "/publisher"))}
          >
            {label}
          </.nav_item>

          <%!-- Libraries section in sidebar --%>
          <%= if Map.get(assigns, :sidebar_libraries) do %>
            <.eyebrow class="px-3 pt-5 pb-1.5">Libraries</.eyebrow>
            <%= for lib <- @sidebar_libraries do %>
              <% progress = Map.get(assigns[:sidebar_scan_progress] || %{}, lib.id)

              pct =
                if progress && progress.total > 0,
                  do: round(progress.scanned / progress.total * 100),
                  else: nil

              scanning = not is_nil(progress) %>
              <div class="flex items-center">
                <.nav_item
                  navigate={"/library/#{lib.id}"}
                  icon={if scanning, do: "lucide-loader-circle", else: "lucide-folder"}
                  icon_class={if scanning, do: "animate-spin text-ink"}
                  active={under?(path, "/library/#{lib.id}")}
                  class="flex-1"
                >
                  <span class="truncate">{lib.name}</span>
                  <span :if={pct} class="ml-auto text-sm text-ink tabular-nums shrink-0">{pct}%</span>
                </.nav_item>
                <.library_menu
                  :if={@current_user.role == :admin}
                  id={"lib-menu-#{lib.id}"}
                  library_id={lib.id}
                  class="ml-0.5 shrink-0"
                />
              </div>
            <% end %>
          <% end %>
        </nav>
      <% end %>
    </aside>
  <% end %>

  <%!-- Main area --%>
  <div class="flex-1 flex flex-col min-w-0">
    <%!-- Top header with search --%>
    <%= if Map.get(assigns, :current_user) do %>
      <% scan_progress = Map.get(assigns, :sidebar_scan_progress) || %{}

      active_tasks =
        scan_progress
        |> Enum.filter(fn {_id, t} -> not t.done end)
        |> Enum.map(fn {id, t} -> {id, t} end)

      all_tasks =
        scan_progress
        |> Enum.map(fn {id, t} -> {id, t} end)

      lib_names =
        (Map.get(assigns, :sidebar_libraries) || []) |> Enum.into(%{}, fn l -> {l.id, l.name} end) %>
      <header class="app-bar relative flex items-center h-16 gap-4 px-4 bg-gray-950">
        <button
          onclick="toggleSidebar()"
          class="lg:hidden p-1.5 rounded-md text-gray-400 hover:text-white hover:bg-white/10 transition-colors flex-shrink-0"
          aria-label="Toggle sidebar"
        >
          <.icon name="lucide-menu" class="w-5 h-5" />
        </button>

        <% navbar_query = Map.get(assigns, :navbar_search_query, "")
        navbar_results = Map.get(assigns, :navbar_search_results, [])
        # Set by pages (the search page) that mirror the navbar box into their own query.
        navbar_sync_query = Map.get(assigns, :navbar_sync_query) %>
        <form
          action="/search"
          method="get"
          phx-submit={navbar_sync_query && "navbar_submit"}
          class="flex-1 max-w-xl"
        >
          <div class="relative group">
            <.icon
              name="lucide-search"
              class="absolute left-1 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 group-focus-within:text-ink transition-colors"
            />
            <input
              id="navbar-search-input"
              type="search"
              name="q"
              value={navbar_sync_query}
              phx-keyup="navbar_search"
              phx-debounce="200"
              phx-blur="navbar_search_clear"
              phx-hook="SearchNav"
              placeholder="Search titles, series, publishers..."
              class="nav-search w-full pl-8 pr-4 sm:pr-20 py-2 text-sm text-white placeholder-gray-500"
              autocomplete="off"
            />
            <span
              :if={!navbar_sync_query}
              class="absolute right-1 top-1/2 -translate-y-1/2 hidden sm:block group-focus-within:opacity-0 transition-opacity duration-100"
            >
              <.kbd keys={["Ctrl", "K"]} />
            </span>
            <%= if navbar_query != "" && navbar_results != [] do %>
              <div
                class="ink-menu fixed top-16 mt-2 left-2 right-3 z-50 sm:absolute sm:top-full sm:left-0 sm:right-0 p-1.5 rounded-md bg-zinc-950 ring-1 ring-white/15"
                onmousedown="event.preventDefault()"
              >
                <div class="overflow-y-auto max-h-[480px]">
                  <%= for result <- navbar_results do %>
                    <.link
                      data-result
                      navigate={
                        if result.type == :series,
                          do: ~p"/series/#{result.id}",
                          else: ~p"/book/#{result.id}"
                      }
                      class="ink-menu-item flex items-center gap-3 px-2 py-1.5 rounded-sm text-sm text-gray-300 hover:bg-white/[0.05] focus:bg-white/[0.07] outline-none transition-colors"
                    >
                      <div class="w-8 h-11 flex-shrink-0 rounded-sm overflow-hidden bg-gray-800">
                        <%= if result.cover do %>
                          <img
                            src={
                              if result.type == :series,
                                do: ~p"/api/series/#{result.id}/cover",
                                else: ~p"/api/books/#{result.id}/cover"
                            }
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        <% else %>
                          <div class="w-full h-full flex items-center justify-center">
                            <.icon name="lucide-image-off" class="w-4 h-4 text-gray-400" />
                          </div>
                        <% end %>
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="truncate text-gray-200 leading-tight">{result.label}</p>
                        <%= if result.sub do %>
                          <p class="text-xs text-gray-400 mt-0.5">{result.sub}</p>
                        <% end %>
                      </div>
                      <.eyebrow tag="span" size="xs" tone="muted" class="shrink-0">
                        {Atom.to_string(result.type)}
                      </.eyebrow>
                    </.link>
                  <% end %>
                </div>
                <.link
                  navigate={~p"/search?#{[q: navbar_query]}"}
                  class="ink-menu-item flex items-center justify-center gap-2 mt-1.5 px-2 py-2 rounded-sm border-t border-white/10 font-display font-bold uppercase tracking-wide text-sm text-gray-200 hover:text-white hover:bg-white/[0.05] focus:bg-white/[0.07] outline-none transition-colors"
                >
                  See all results for "{navbar_query}" <.icon name="lucide-arrow-right" class="w-3.5 h-3.5 text-ink" />
                </.link>
              </div>
            <% end %>
          </div>
        </form>

        <div class="ml-auto flex items-center gap-2">
          <%!-- Activity indicator dropdown --%>
          <.ink_menu id="activity-menu" panel_class="w-72">
            <:trigger
              label="Background tasks"
              class={[
                "relative p-1.5 rounded-lg transition-colors hover:bg-white/10 flex items-center justify-center",
                if(active_tasks != [], do: "text-ink", else: "text-gray-400 hover:text-white")
              ]}
            >
              <.icon name="lucide-activity" class={"w-4 h-4 #{if active_tasks != [], do: "animate-pulse"}"} />
              <span
                :if={active_tasks != []}
                class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-ink rounded-full animate-ping"
              ></span>
            </:trigger>
            <.menu_label>Background tasks</.menu_label>
            <p :if={all_tasks == []} class="px-2 pt-1 pb-2 text-sm text-gray-400">Nothing running</p>
            <div
              :for={{lib_id, task} <- all_tasks}
              id={"task-#{lib_id}"}
              class="px-2 py-2 border-t border-white/10 first-of-type:border-t-0"
            >
              <% pct = if task.total > 0, do: task.scanned / task.total %>
              <div class="flex items-baseline justify-between gap-3">
                <span class="min-w-0 truncate font-display font-bold uppercase tracking-wide text-sm text-white">
                  {Map.get(lib_names, lib_id, "Library")}
                </span>
                <span class="flex-shrink-0 font-display font-black text-lg leading-none tabular-nums text-ink">
                  {cond do
                    task.done -> "Done"
                    pct -> "#{round(pct * 100)}%"
                    true -> "…"
                  end}
                </span>
              </div>
              <p class="mt-0.5 mb-2 text-[11px] text-gray-400">
                {cond do
                  task.done -> "Complete"
                  Map.get(task, :phase) == :thumbnails -> "Generating covers"
                  Map.get(task, :phase) == :file -> "Indexing new file"
                  true -> "Scanning files"
                end}
                <span :if={!task.done} class="tabular-nums"> · {task.scanned} / {task.total} files</span>
              </p>
              <.run_bar
                value={if task.done, do: 1.0, else: pct}
                label={"#{Map.get(lib_names, lib_id, "Library")} scan progress"}
              />
            </div>
          </.ink_menu>

          <div class="w-px h-5 bg-white/15 flex-shrink-0"></div>

          <%!-- User menu dropdown --%>
          <.ink_menu id="user-menu" class="group">
            <:trigger class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-white/10 transition-colors">
              <div class="w-7 h-7 rounded-full bg-violet-700 flex items-center justify-center text-xs font-bold text-white">
                {String.upcase(String.first(@current_user.username || "?"))}
              </div>
              <span class="hidden sm:block text-sm text-gray-300">{@current_user.username}</span>
              <.icon
                name="lucide-chevron-down"
                class="w-3.5 h-3.5 text-gray-400 transition-transform group-data-[open]:rotate-180"
              />
            </:trigger>
            <.menu_item :if={@current_user.role == :admin} icon="lucide-settings" navigate="/admin/users">
              System settings
            </.menu_item>
            <.menu_item icon="lucide-log-out" href="/logout" method="delete">Sign out</.menu_item>
          </.ink_menu>
        </div>
      </header>
    <% end %>

    <main class="flex-1 overflow-auto">
      <.flash_group flash={@flash} />
      <div class="px-6 py-6 xl:px-12 2xl:px-20">
        {@inner_content}
      </div>
    </main>
  </div>
</div>

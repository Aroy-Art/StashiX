<!DOCTYPE html> <% theme = theme_attr(@conn) %>
<html lang="en" data-theme={theme} class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="sw-no-cache" content={to_string(dev_routes())} />
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <%!-- Matches the top band (--color-band), dark in every theme. --%>
    <meta name="theme-color" content="#030712" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Stashix" />
    <link rel="apple-touch-icon" href={~p"/icons/icon-192.png"} />
    <.live_title default="Stashix" suffix=" · Stashix">
      {assigns[:page_title]}
    </.live_title>
    <%!-- The display face sets the sidebar and every heading. Without the preload it
         is only requested once the CSS is parsed, and the first paint shows the
         fallback before swapping. --%>
    <link
      rel="preload"
      href={~p"/fonts/big-shoulders-display-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <%!-- Inline critical styles: prevent white flash before app.css loads, and
         define the initial-load overlay + spinner (inline so it works before
         the external stylesheet is parsed). --%>
    <style>
      html { color-scheme: dark; background: light-dark(#d4d1ca, #030712) }
      html[data-theme=light] { color-scheme: light }
      html[data-theme=system] { color-scheme: light dark }
      #stx-loader { transition: opacity 0.25s ease }
      #stx-loader svg { opacity: 0; animation: stx-spin 0.9s linear infinite, stx-appear 0.001s ease 1.6s forwards }
      @keyframes stx-spin  { to { transform: rotate(360deg) } }
      @keyframes stx-appear { to { opacity: 1 } }
    </style>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-canvas text-fg antialiased">
    <%!-- Full-page cover: same bg as app so no visual difference when removed.
         Inline styles make it render-independent from app.css. Spinner appears
         after 500 ms via CSS animation so fast loads never see it. --%>
    <div
      id="stx-loader"
      style="position:fixed;inset:0;background:light-dark(#d4d1ca, #030712);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;z-index:9999"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="16" stroke="rgba(79,232,235,0.15)" stroke-width="3" />
        <path d="M20 4 A16 16 0 0 1 36 20" stroke="#4fe8eb" stroke-width="3" stroke-linecap="round" />
      </svg>
      <button
        id="stx-loader-refresh"
        onclick="window.location.reload()"
        style="display:none;padding:8px 20px;background:transparent;border:1px solid light-dark(rgba(0,0,0,0.2), rgba(255,255,255,0.2));border-radius:6px;color:light-dark(rgba(0,0,0,0.6), rgba(255,255,255,0.6));font-size:14px;cursor:pointer;font-family:inherit"
      >Refresh page</button>
    </div>
    <script>
      setTimeout(function() {
        var btn = document.getElementById("stx-loader-refresh");
        var loader = document.getElementById("stx-loader");
        if (btn && loader && loader.isConnected) btn.style.display = "block";
      }, 10000);
    </script>
    {@inner_content}

    <%!-- WebSocket offline banner: shown by JS when the LiveSocket drops --%>
    <div
      id="ws-offline-banner"
      hidden
      role="alert"
      aria-live="assertive"
      class="fixed bottom-0 left-0 right-0 z-[9998] flex items-center gap-3 h-9 px-4 bg-orange-500 border-t border-orange-400 overflow-hidden"
    >
      <div class="ws-hazard-stripes absolute inset-0 pointer-events-none"></div>
      <svg
        class="relative shrink-0 w-4 h-4 text-orange-950 animate-pulse"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="1" y1="1" x2="23" y2="23" />
        <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55" />
        <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39" />
        <path d="M10.71 5.05A16 16 0 0 1 22.56 9" />
        <path d="M1.42 9a16 16 0 0 1 4.7-2.88" />
        <path d="M8.53 16.11a6 6 0 0 1 6.95 0" />
        <line x1="12" y1="20" x2="12.01" y2="20" />
      </svg>
      <span class="relative font-display font-black uppercase tracking-[0.07em] text-orange-950 text-sm leading-none flex-1 min-w-0 truncate">
        No signal — connection lost
      </span>
      <button
        id="ws-reconnect-btn"
        class="ws-reconnect-btn relative shrink-0 font-display font-black uppercase tracking-[0.06em] text-xs px-3 py-1 bg-orange-950 text-orange-300 rounded-sm hover:text-fg transition-colors"
      >
        Reconnect
      </button>
    </div>
  </body>
</html>

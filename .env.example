PHX_HOST=your-domain.com

POSTGRES_DB=stashix
POSTGRES_USER=stashix
POSTGRES_PASSWORD=changeme

DATABASE_URL=ecto://stashix:changeme@db/stashix

SECRET_KEY_BASE=change-this-to-a-64-char-random-string

# Signs login tokens. Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-different-random-string

# Encrypts stored metadata source credentials and cookies. Required.
# Generate with: openssl rand -base64 32
# Don't change it once set: data encrypted with the old key becomes unreadable.
# Installs that started without it can add one: existing data is re-encrypted
# with it on the next start. Don't change JWT_SECRET in the same restart.
STASHIX_ENCRYPTION_KEY=

# Media folder on the host (this machine, not inside the container) that
# holds your libraries. Compose mounts it into the container at /libraries;
# in Stashix, point each library at a folder under it, e.g. /libraries/comics.
LIBRARIES_PATH=/path/to/your/media

# User and group IDs the server runs as inside the container. Must be able to
# read and write LIBRARIES_PATH; the data volume is chowned to them on start.
PUID=1000
PGID=1000

# --- Optional runtime settings (prod) ---
# docker-compose.yml does not forward these; add them to the phoenix
# service's environment block to use them there.

# HTTP port the server listens on (default: 4000)
# PORT=4000

# Database connection pool size (default: 10)
# POOL_SIZE=10

# Set to true or 1 to connect to the database over IPv6
# ECTO_IPV6=false

# DNS query for discovering other nodes when clustering
# DNS_CLUSTER_QUERY=

# --- Optional storage paths ---
# Base data directory. The Docker image defaults to /data. When set, the dirs
# below default to subdirectories of it: thumbnails/, cache/images/resized/
# and cache/images/metadata/.
# DATA_DIR=/data

# Override individual dirs. Without DATA_DIR they default to tmp/data/ in the repo.
# THUMBNAIL_DIR=
# IMAGE_CACHE_DIR=
# METADATA_IMAGE_DIR=

# --- Local development only (mix phx.server, config/dev.exs) ---
# Nothing loads this file in dev; export these in your shell.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stashix_dev
# DB_USER=stashix
# DB_PASSWORD=changeme
